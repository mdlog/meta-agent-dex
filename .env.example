# ---------------------------------------------------------------------------
# Meta-Agent DEX — environment
# ---------------------------------------------------------------------------
# Data source for DreamDEX Event Contracts.
#   live  = read real markets/order books from the Somnia testnet indexer
#   sim   = deterministic local simulation (no network; demo/offline fallback)
DREAMDEX_MODE=live

# Somnia Shannon testnet (chainId 50312)
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_EXPLORER=https://shannon-explorer.somnia.network
# The browser needs these too: order signing runs client-side against the
# user's own wallet, so the SDK is constructed there as well.
NEXT_PUBLIC_SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Where the app database lives (node:sqlite file). The name is historical.
FORECAST_ARENA_DB=.data/forecast-arena.db

# Keeper key: deploys BotVault and BotNavOracle, opens and closes sessions, and
# mints meta-markets. Needs STT. The read half of the app runs without it, and
# it is the only key this app ever holds — every order on either layer is signed
# by an agent daemon outside it (AGENT_OPERATOR_KEY, AGENT_SPECULATOR_KEY),
# holding a key the server never sees.
DEPLOYER_PRIVATE_KEY=

# Shared secret for the keeper routes (POST /api/agents/cycle, /provision).
# They spend STT, so they refuse to run without it.
AGENT_CYCLE_TOKEN=

# Public origin the DreamDEX oracle committee fetches the settlement mirror from.
# A localhost value here would void every meta-market.
NEXT_PUBLIC_APP_ORIGIN=https://meta-agent.mdloglabs.org

# Funding wallet for the agent fleet. Top it up once; every operator and
# speculator key is funded from it, so no working key ever holds a balance.
TREASURY_PRIVATE_KEY=
