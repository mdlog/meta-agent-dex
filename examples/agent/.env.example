# Copy to .env and fill in. Nothing here is read by the arena — these files stay
# on your machine.

# --- who you are -------------------------------------------------------------
# The wallet that deploys and owns the vault, funds it, and opens sessions.
# Needs STT (gas) and tUSDC (trading capital).
OWNER_PRIVATE_KEY=0x

# The bot's key. May only call trade(). Needs a little STT and nothing else.
# `npm run keys` prints a fresh one.
OPERATOR_PRIVATE_KEY=0x

# --- filled in as you go ------------------------------------------------------
# Printed by `npm run deploy`.
VAULT_ADDRESS=

# Printed by `npm run register`.
AGENT_SLUG=

# --- where ------------------------------------------------------------------
ARENA_API=https://meta-agent.mdloglabs.org
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# --- how it trades -----------------------------------------------------------
# Declare these at registration too, so what you published matches what you run.
AGENT_NAME=Example Agent
SESSION_SEC=5400
# 45000 = 0.045. Entry costs ~0.031 (2.8pt median spread + a crossing tick), so
# anything under that loses on average however good the signal is. See README.
DRIFT_THRESHOLD=45000
LOOKBACK_SEC=90
# Never pay more than 0.65 per contract. At 0.80 you stake 80c to win 20.
MAX_ENTRY=650000
# Most collateral one order may escrow, raw 6dp. 15 tUSDC.
MAX_ORDER=15000000
# Never spend the vault below this. 10 tUSDC.
MIN_CASH=10000000
POLL_MS=8000

# --- the brain ----------------------------------------------------------------
# The model that decides whether each sized order is actually sent. Leave the key
# blank and the agent runs on view() alone — the deterministic behaviour it had
# before the gate existed. Nothing else changes.
#
# The model can only NARROW: reject an order, or accept it at a smaller size. It
# cannot pick a different market, a different side, or a bigger order. That bound
# is what makes it safe to put a contract's own question text into the prompt.
#
# Get a key at https://console.anthropic.com/. It is read from THIS file only —
# env.ts never reaches for the repo's .env.local.
ANTHROPIC_API_KEY=

# Optional. claude-sonnet-5 is the default: the decisions are frequent, small and
# latency-sensitive. claude-opus-5 reasons harder and answers slower.
AGENT_MODEL=claude-sonnet-5

# The poll floor is 3s, so a timeout above it would let one slow call swallow a
# whole cycle. 5s fits inside the 8s default with room to send the order.
AGENT_MODEL_TIMEOUT_MS=5000
